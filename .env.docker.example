# Docker Compose local environment (server single-box)
#
# Copy to `.env.docker` on the server and edit secrets:
#   cp .env.docker.example .env.docker
#
# Use with:
#   docker compose --env-file .env.docker up -d --build

# Server
PORT=8080

# Database (local container)
DB_HOST=postgres
DB_PORT=5432
DB_USER=postgres
DB_PASS=postgres
DB_NAME=shukisha
DB_SSLMODE=disable
DB_TIMEZONE=Africa/Nairobi

# Redis (local container)
REDIS_HOST=redis
REDIS_PORT=6379

# Security
JWT_SECRET=REPLACE_ME_LONG_RANDOM
OTP_EXPIRY=5m
JWT_EXPIRY=24h

# CORS
# Comma-separated list of allowed origins. Example:
# CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Set to "*" to allow all (development only).
CORS_ALLOWED_ORIGINS=*

# Notifications
# When false, driver notify jobs are marked SENT without sending real SMS.
DRIVER_NOTIFY_SEND_ENABLED=false

# Cloudinary (Claims evidence storage)
# Use authenticated/private delivery.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Twilio (optional; required only if you want real SMS sending)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
